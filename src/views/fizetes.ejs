<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fizetés - Beach Barbershop</title>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/fizetes.css">
</head>
<body>
    <!-- 🌊 VIDEÓ HÁTTÉR -->
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
      A böngésződ nem támogatja a videó elemet.
    </video>

    <header>
      <a href="/" class="logo">Beach Barbershop</a>

      <!-- Mobil header jobb oldali rész (kosár + hamburger) -->
      <div class="mobile-header-right">
        <!-- Mobil kosár ikon -->
        <div class="cart-menu mobile-cart">
          <div class="cart-icon-wrap">
            <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            <span class="cart-badge" id="cartBadgeMobile">0</span>
          </div>
          <ul class="cart-dropdown" id="cartDropdownMobile">
            <li class="cart-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              <span>Kosár</span>
              <span class="cart-header-count" id="cartHeaderCountMobile">0 termék</span>
            </li>
            <li class="cart-items-wrap">
              <div id="cartItemsMobile"></div>
            </li>
            <li class="cart-total-row">
              <span>Összesen</span>
              <span class="cart-total-amount"><span id="cartSumMobile">0</span> Ft</span>
            </li>
            <li class="cart-actions">
              <a href="/fizetes" class="cart-btn-pay">💳 Fizetés</a>
              <button onclick="clearCart()" class="cart-btn-clear" title="Kosár törlése">🗑️</button>
            </li>
            <li class="cart-continue">
              <a href="/shop">Folytasd a vásárlást →</a>
            </li>
          </ul>
        </div>

        <!-- Hamburger menü gomb mobilra -->
        <button class="hamburger" id="hamburgerBtn" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <nav id="mainNav">
        <ul class="nav-list">
          <!-- Mobil profil a slide-in tetején + almenü -->
          <li class="profile-menu mobile-profile-top">
            <div class="mobile-profile-header">
              <img src="https://cdn-icons-png.flaticon.com/512/1077/1077063.png" class="mobile-profile-icon" alt="Profil" />
              <% if (user) { %>
              <span class="mobile-profile-toggle"><%= (user && user.role === 'ADMIN') ? 'Admin Panel' : 'Fiók' %> ▼</span>
              <% } else { %>
              <a href="/bejelentkezes">Bejelentkezés</a>
              <% } %>
            </div>
            <% if (user) { %>
            <ul class="mobile-profile-submenu">
              <li><a href="/fiok">Fiók részletek</a></li>
              <li><a href="/fiok#foglalasaim">Foglalásaim</a></li>
              <li><a href="/fiok#rendeleseim">Rendeléseim</a></li>
            </ul>
            <% } %>
          </li>

          <li><a href="/">Főoldal</a></li>
          <li><a href="/shop">Webshop</a></li>

          <!-- KIJELENTKEZÉS (csak mobilon, menü végén) -->
          <% if (user) { %>
          <li class="mobile-logout"><a href="/api/logout">Kijelentkezés</a></li>
          <% } %>

          <!-- Desktop KOSÁR IKON -->
          <li class="cart-menu desktop-cart">
            <div class="cart-icon-wrap">
              <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              <span class="cart-badge" id="cartBadge">0</span>
            </div>
            <ul class="cart-dropdown" aria-hidden="true" id="cartDropdown">
              <li class="cart-header">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                <span>Kosár</span>
                <span class="cart-header-count" id="cartHeaderCount">0 termék</span>
              </li>
              <li class="cart-items-wrap">
                <div id="cartItems"></div>
              </li>
              <li class="cart-total-row">
                <span>Összesen</span>
                <span class="cart-total-amount"><span id="cartSum">0</span> Ft</span>
              </li>
              <li class="cart-actions">
                <a href="/fizetes" class="cart-btn-pay">💳 Fizetés</a>
                <button onclick="clearCart()" class="cart-btn-clear" title="Kosár törlése">🗑️</button>
              </li>
              <li class="cart-continue">
                <a href="/shop">Folytasd a vásárlást →</a>
              </li>
            </ul>
          </li>

          <!-- Desktop PROFIL IKON MENÜ -->
          <li class="profile-menu desktop-profile">
            <div class="profile-icon-wrap">
              <svg class="profile-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>

            <ul class="dropdown" aria-hidden="true">
              <% if (user) { %>
              <li style="padding: 0.6rem 1rem; color: #3cbcc7; font-weight: 700"><%= user.felhnev %></li>
              <% if (user && user.role === 'ADMIN') { %>
              <li><a href="/fiok">Fiók</a></li>
              <li><a href="/admin">Admin Panel</a></li>
              <% } else { %>
              <li><a href="/fiok">Fiók</a></li>
              <% } %>
              <li>
                <form action="/api/logout" method="get">
                  <button type="submit" class="logout-btn">Kijelentkezés</button>
                </form>
              </li>
              <% } else { %>
              <li><a href="/bejelentkezes">Bejelentkezés</a></li>
              <li><a href="/regisztracio">Regisztráció</a></li>
              <% } %>
            </ul>
          </li>
        </ul>
      </nav>
    </header>

    <section class="payment-container">
      <h1>Fizetés</h1>
      <div id="orderMessage" class="order-message" aria-hidden="true"></div>
      
      <div class="payment-content">
        <!-- Kosár összegzés -->
        <div class="cart-summary">
          <h2>Kosár összegzése</h2>
          <div id="paymentCartItems"></div>
          <div class="summary-line">
            <strong>Termékek összesen:</strong>
            <span id="paymentSubtotal">0 Ft</span>
          </div>
          <div class="summary-line">
            <strong>Szállítási díj:</strong>
            <span id="paymentShipping">0 Ft</span>
          </div>
          <div class="summary-total">
            <strong>Végösszeg:</strong>
            <span id="paymentTotal">0 Ft</span>
          </div>
        </div>

        <!-- Szállítási opciók -->
        <div class="shipping-options">
          <h2>Szállítási mód</h2>
          
          <div class="option-container">
            <label class="option-label">
              <input type="radio" name="shipping" value="home" checked>
              <div class="option-content">
                <h3>🚚 Házhoz szállítás</h3>
                <p>A terméket házához szállítjuk</p>
                <p class="price">+ 1,490 Ft</p>
              </div>
            </label>
          </div>

          <div class="option-container">
            <label class="option-label">
              <input type="radio" name="shipping" value="pickup">
              <div class="option-content">
                <h3>🏪 Átvétel a barbershopban</h3>
                <p>A következő időpontkor felveheted a terméket</p>
                <p class="price">Ingyenes</p>
              </div>
            </label>
          </div>
        </div>

        <!-- Külön konténer a házhozszállítási űrlapnak (vízszintes elrendezés) -->
        <div class="delivery-container">
          <div class="delivery-form" id="deliveryForm" aria-hidden="true">
            <h3>Szállítási adatok</h3>
            <div class="input-row">
              <label>Teljes név <span class="required">*</span>
                <input type="text" id="del_name" name="del_name" placeholder="Vezetéknév Keresztnév" />
                <span class="field-error" id="err_name"></span>
              </label>
            </div>

            <div class="input-row">
              <label>Telefonszám <span class="required">*</span>
                <div class="del-phone-group">
                  <select id="del_phone_prefix" class="del-phone-prefix">
                    <option value="+36">🇭🇺 +36</option>
                    <option value="+1">🇺🇸 +1</option>
                    <option value="+44">🇬🇧 +44</option>
                    <option value="+49">🇩🇪 +49</option>
                    <option value="+33">🇫🇷 +33</option>
                    <option value="+40">🇷🇴 +40</option>
                    <option value="+43">🇦🇹 +43</option>
                    <option value="+421">🇸🇰 +421</option>
                    <option value="+420">🇨🇿 +420</option>
                    <option value="+48">🇵🇱 +48</option>
                  </select>
                  <input type="tel" id="del_phone" name="del_phone" placeholder="30 123 4567" />
                </div>
                <span class="field-error" id="err_phone"></span>
              </label>
            </div>

            <div class="input-row">
              <label>Utca, házszám <span class="required">*</span>
                <input type="text" id="del_address" name="del_address" placeholder="Kossuth L. u. 1" />
                <span class="field-error" id="err_address"></span>
              </label>
            </div>

            <div class="input-row">
              <label>Irányítószám <span class="required">*</span>
                <input type="text" id="del_postal" name="del_postal" placeholder="1234" />
                <span class="field-error" id="err_postal"></span>
              </label>
            </div>

            <div class="input-row">
              <label>Város <span class="required">*</span>
                <input type="text" id="del_city" name="del_city" placeholder="Budapest" />
                <span class="field-error" id="err_city"></span>
              </label>
            </div>

            <div class="input-row">
              <label>Megjegyzés (opcionális)
                <input type="text" id="del_note" name="del_note" placeholder="Pl. kapucsengő: 12" />
              </label>
            </div>
          </div>
        </div>

        <!-- Fizetés gomb -->
        <div class="payment-actions">
          <button id="paymentBtn" class="btn-payment">Fizetés</button>
          <a href="/shop" class="btn-back">Vissza a shop-hoz</a>
        </div>
      </div>
    </section>

    <footer>
      <p>&copy; 2025 Beach Barbershop</p>
    </footer>

    <script>
      // Kosár funkciók
      function updatePaymentDisplay() {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        const paymentCartItems = document.getElementById("paymentCartItems");
        const paymentSubtotal = document.getElementById("paymentSubtotal");
        const paymentShipping = document.getElementById("paymentShipping");
        const paymentTotal = document.getElementById("paymentTotal");
        
        // Desktop és mobil badge
        const cartBadge = document.getElementById("cartBadge");
        const cartBadgeMobile = document.getElementById("cartBadgeMobile");
        const cartHeaderCount = document.getElementById("cartHeaderCount");
        const cartHeaderCountMobile = document.getElementById("cartHeaderCountMobile");
        
        // Desktop és mobil kosár tartalom
        const cartItems = document.getElementById("cartItems");
        const cartItemsMobile = document.getElementById("cartItemsMobile");
        const cartSum = document.getElementById("cartSum");
        const cartSumMobile = document.getElementById("cartSumMobile");

        const itemCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        if (cartBadge) cartBadge.textContent = itemCount;
        if (cartBadgeMobile) cartBadgeMobile.textContent = itemCount;
        
        const countLabel = itemCount === 0 ? "Üres" : `${itemCount} termék`;
        if (cartHeaderCount) cartHeaderCount.textContent = countLabel;
        if (cartHeaderCountMobile) cartHeaderCountMobile.textContent = countLabel;
        
        paymentCartItems.innerHTML = "";

        let subtotal = 0;
        let cartItemsHtml = "";

        if (cart.length === 0) {
          paymentCartItems.innerHTML = '<p style="color: #999; text-align: center; padding: 1rem;">A kosár üres</p>';
          cartItemsHtml = '<div class="cart-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg><span>A kosár üres</span></div>';
        } else {
          cart.forEach((item) => {
            const price = typeof item.price === "number" ? item.price : parseInt((item.price || "").toString().replace(/\D/g, "")) || 0;
            const quantity = item.quantity || 1;
            const itemTotal = price * quantity;
            subtotal += itemTotal;
            const div = document.createElement("div");
            div.innerHTML = `
              <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #555;">
                <span>${item.name} × ${quantity}</span>
                <span>${(itemTotal).toLocaleString("hu-HU")} Ft</span>
              </div>
            `;
            paymentCartItems.appendChild(div);
            
            cartItemsHtml += `
              <div class="cart-item">
                <div class="cart-item-info">
                  <span class="cart-item-name">${item.name}</span>
                  <span class="cart-item-meta">${quantity} × ${price.toLocaleString("hu-HU")} Ft</span>
                </div>
                <div class="cart-item-right">
                  <span class="cart-item-total">${itemTotal.toLocaleString("hu-HU")} Ft</span>
                </div>
              </div>
            `;
          });
        }

        // Kosár dropdown tartalom frissítés
        if (cartItems) cartItems.innerHTML = cartItemsHtml;
        if (cartItemsMobile) cartItemsMobile.innerHTML = cartItemsHtml;
        
        const subtotalStr = subtotal.toLocaleString("hu-HU");
        if (cartSum) cartSum.textContent = subtotalStr;
        if (cartSumMobile) cartSumMobile.textContent = subtotalStr;

        // Szállítási díj
        const shippingRadios = document.getElementsByName("shipping");
        let shippingCost = 0;
        let selectedShipping = "home";

        shippingRadios.forEach((radio) => {
          if (radio.checked) {
            selectedShipping = radio.value;
            if (selectedShipping === "home") {
              shippingCost = 1490;
            }
          }
        });

        const total = subtotal + shippingCost;

        paymentSubtotal.textContent = subtotal.toLocaleString("hu-HU") + " Ft";
        paymentShipping.textContent = shippingCost > 0 ? shippingCost.toLocaleString("hu-HU") + " Ft" : "Ingyenes";
        paymentTotal.textContent = total.toLocaleString("hu-HU") + " Ft";
      }

      function clearCart() {
        localStorage.setItem("cart", JSON.stringify([]));
        updatePaymentDisplay();
      }

      document.addEventListener("DOMContentLoaded", () => {
        updatePaymentDisplay();

        // Szállítási mód váltásakor frissítés
        const shippingRadios = document.getElementsByName("shipping");
        shippingRadios.forEach((radio) => {
          radio.addEventListener("change", updatePaymentDisplay);
        });

        // Fizetés gomb
        const paymentBtn = document.getElementById("paymentBtn");
        if (paymentBtn) {
          paymentBtn.addEventListener("click", async () => {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if (cart.length === 0) {
              showOrderMessage('A kosár üres!', 'error');
              return;
            }

            const selectedShipping = document.querySelector('input[name="shipping"]:checked').value;
            
            // Számítás
            let subtotal = 0;
            cart.forEach(item => {
              const price = item.price || parseInt((item.price || "").toString().replace(/\D/g, "")) || 0;
              const quantity = item.quantity || 1;
              subtotal += price * quantity;
            });
            const shippingCost = selectedShipping === "home" ? 1490 : 0;
            const totalPrice = subtotal + shippingCost;

            // Ha házhoz szállítás, validáljuk a kötelező mezőket inline
            const deliveryForm = document.getElementById('deliveryForm');
            const isHome = (selectedShipping === 'home');

            function clearErrors() {
              document.querySelectorAll('.field-error').forEach(el => { el.textContent = ''; el.classList.remove('visible'); });
            }

            function validateDelivery() {
              clearErrors();
              if (!isHome) return true;
              let ok = true;
              const name = document.getElementById('del_name').value.trim();
              const phone = document.getElementById('del_phone').value.trim();
              const address = document.getElementById('del_address').value.trim();
              const postal = document.getElementById('del_postal').value.trim();
              const city = document.getElementById('del_city').value.trim();

              if (!name) { document.getElementById('err_name').textContent = 'Kötelező megadni a teljes nevet.'; document.getElementById('err_name').classList.add('visible'); ok = false; }
              if (!phone) { document.getElementById('err_phone').textContent = 'Kötelező telefonszámot megadni.'; document.getElementById('err_phone').classList.add('visible'); ok = false; }
              if (!address) { document.getElementById('err_address').textContent = 'Kötelező az utca és házszám.'; document.getElementById('err_address').classList.add('visible'); ok = false; }
              if (!postal) { document.getElementById('err_postal').textContent = 'Kötelező az irányítószám.'; document.getElementById('err_postal').classList.add('visible'); ok = false; }
              if (!city) { document.getElementById('err_city').textContent = 'Kötelező a város megadása.'; document.getElementById('err_city').classList.add('visible'); ok = false; }

              return ok;
            }

            if (!validateDelivery()) {
              // Ne küldjük el, csak jelezzük a hibákat az űrlapon
              // görgessünk a formra, hogy a felhasználó lássa
              if (deliveryForm) deliveryForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
              return;
            }

            // Adatbázisba mentés
            try {
              const formData = new URLSearchParams();
              formData.append("products", JSON.stringify(cart));
              formData.append("shippingType", selectedShipping);
              formData.append("totalPrice", totalPrice);

              if (isHome) {
                const addressObj = {
                  name: document.getElementById('del_name').value.trim(),
                  phone: document.getElementById('del_phone_prefix').value + ' ' + document.getElementById('del_phone').value.trim(),
                  address: document.getElementById('del_address').value.trim(),
                  postal: document.getElementById('del_postal').value.trim(),
                  city: document.getElementById('del_city').value.trim(),
                  note: document.getElementById('del_note').value.trim() || ''
                };
                formData.append('address', JSON.stringify(addressObj));
              }

              const res = await fetch("/api/order", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: formData,
              });

              const json = await res.json();
              if (res.ok && json.ok) {
                showOrderMessage('Rendelés rögzítve. Köszönjük a vásárlást!', 'success');
                localStorage.removeItem('cart');
                setTimeout(() => { window.location.href = '/shop'; }, 2200);
              } else {
                showOrderMessage('Hiba történt a rendelés mentésekor!', 'error');
              }
            } catch (err) {
              console.error(err);
              showOrderMessage('Nem sikerült elérni a szervert!', 'error');
            }
          });
        }

        // Kosár ikon klikk - mindkét kosárra (mobil és desktop)
        const cartIconWraps = document.querySelectorAll(".cart-icon-wrap");
        cartIconWraps.forEach(cartIconWrap => {
          const cartMenu = cartIconWrap.closest(".cart-menu");
          if (cartIconWrap && cartMenu) {
            cartIconWrap.addEventListener("click", (e) => {
              e.stopPropagation();
              cartMenu.classList.toggle("open");
              const cartDropdown = cartMenu.querySelector(".cart-dropdown");
              if (cartDropdown) {
                const isOpen = cartMenu.classList.contains("open");
                cartDropdown.setAttribute("aria-hidden", !isOpen);
              }
            });
          }
        });

        // Profil ikon -> lenyíló menü (desktop)
        const profileMenu = document.querySelector(".desktop-profile");
        const profileIcon = profileMenu ? profileMenu.querySelector(".profile-icon-wrap") : null;

        if (profileIcon && profileMenu) {
          profileIcon.addEventListener("click", (e) => {
            e.stopPropagation();
            profileMenu.classList.toggle("open");
            const dropdown = profileMenu.querySelector(".dropdown");
            if (dropdown) {
              const isOpen = profileMenu.classList.contains("open");
              dropdown.setAttribute("aria-hidden", !isOpen);
            }
          });
        }

        // Klikk bárhova -> bezár
        document.addEventListener("click", () => {
          if (profileMenu) {
            profileMenu.classList.remove("open");
            const dropdown = profileMenu.querySelector(".dropdown");
            if (dropdown) dropdown.setAttribute("aria-hidden", "true");
          }
          // Minden kosár menü bezárása
          document.querySelectorAll(".cart-menu").forEach(cm => cm.classList.remove("open"));
          document.querySelectorAll(".cart-dropdown").forEach(cd => cd.setAttribute("aria-hidden", "true"));
        });

        // További: megjelenítés/eltüntetés a delivery formhoz
        const deliveryForm = document.getElementById('deliveryForm');
        const shippingRadiosAll = document.getElementsByName('shipping');

        function toggleDeliveryForm() {
          const sel = document.querySelector('input[name="shipping"]:checked').value;
          if (deliveryForm) {
            if (sel === 'home') {
              deliveryForm.style.display = '';
              deliveryForm.setAttribute('aria-hidden','false');
            } else {
              deliveryForm.style.display = 'none';
              deliveryForm.setAttribute('aria-hidden','true');
            }
          }
        }

        // Init state
        toggleDeliveryForm();

        shippingRadiosAll.forEach(r => r.addEventListener('change', toggleDeliveryForm));

        // Inline order message helper (success / error)
        function showOrderMessage(text, type) {
          const msg = document.getElementById('orderMessage');
          if (!msg) { alert(text); return; }
          msg.textContent = text;
          msg.classList.remove('success','error','visible');
          msg.classList.add(type === 'success' ? 'success' : 'error');
          msg.classList.add('visible');
          msg.setAttribute('aria-hidden','false');
          msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (type === 'success') {
            // auto-hide after short delay (redirect happens elsewhere)
            setTimeout(() => { msg.classList.remove('visible'); msg.setAttribute('aria-hidden','true'); }, 2000);
          }
        }

        // Mobil profil almenü toggle
        const mobileProfileHeader = document.querySelector(".mobile-profile-header");
        const mobileProfileSubmenu = document.querySelector(".mobile-profile-submenu");
        const mobileProfileToggle = document.querySelector(".mobile-profile-toggle");
        
        if (mobileProfileHeader && mobileProfileSubmenu) {
          mobileProfileHeader.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileProfileSubmenu.classList.toggle("open");
            // Nyíl irány váltás
            if (mobileProfileToggle) {
              mobileProfileToggle.textContent = mobileProfileSubmenu.classList.contains("open") ? "Fiók ▲" : "Fiók ▼";
            }
          });
        }
      });
    </script>
    <script src="/js/mobileNav.js"></script>
  </body>
  </html>
