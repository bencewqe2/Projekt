<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fiók – Beach Barbershop</title>

    <link rel="stylesheet" href="/css/fiok.css" />
  </head>

  <body>
    <!-- Videó háttér -->
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
      A böngésződ nem támogatja a videó elemet.
    </video>

    <header>
      <div class="logo">Beach Barbershop</div>
      <nav>
        <ul>
          <li><a href="/">Vissza a főoldalra</a></li>
        </ul>
      </nav>
    </header>

    <div class="account-header">Üdv, <%= user.felhnev %></div>

    <div class="account-wrapper">
      <aside class="account-sidebar">
        <button onclick="showSection('info')">Fiók részletek</button>
        <button onclick="showSection('bookings')">Foglalások</button>
        <button onclick="showSection('orders')">Rendelések</button>
      </aside>

      <main class="account-content">
        <section id="info" class="account-section active">
          <p><strong>Felhasználónév:</strong> <%= user.felhnev %></p>
          <p><strong>Email:</strong> <%= user.email %></p>
          <p><strong>Telefonszám:</strong> <%= user.pnumber || "nincs megadva" %></p>
          <p><strong>Jelszó:</strong> ********</p>
        </section>

        <section id="bookings" class="account-section">
          <h2>Foglalásaim</h2>
          <div id="bookingsContainer">
            <p style="text-align: center; color: #999">Betöltés...</p>
          </div>
        </section>

        <section id="orders" class="account-section">
          <h2>Rendeléseim</h2>
          <div id="ordersContainer">
            <p style="text-align: center; color: #999">Betöltés...</p>
          </div>
        </section>
      </main>
    </div>

    <!-- Toast Notification -->
    <div id="toastNotification" class="toast-notification"></div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteConfirmModal" class="delete-confirm-modal">
      <div class="delete-confirm-content">
        <h3>Törlés megerősítése</h3>
        <p id="deleteConfirmMessage">Biztosan törlöd a foglalást?</p>
        <div class="delete-confirm-buttons">
          <button id="btnConfirmDelete" class="btn-confirm">✓ Igen, törlöm</button>
          <button id="btnCancelDelete" class="btn-cancel">✕ Mégsem</button>
        </div>
      </div>
    </div>

    <script>
      function showToast(message, type = "success") {
        const toast = document.getElementById("toastNotification");
        toast.textContent = message;
        toast.className = `toast-notification toast-${type} show`;
        setTimeout(() => {
          toast.classList.remove("show");
        }, 3000);
      }
      function showSection(id) {
        document.querySelectorAll(".account-section").forEach((s) => s.classList.remove("active"));
        document.getElementById(id).classList.add("active");
        if (id === "orders") {
          loadOrders();
        }

        // Foglalások betöltése, amikor a foglalások szekciót megnyitják
        if (id === "bookings") {
          loadBookings();
        }
      }

      async function loadOrders() {
        try {
          const res = await fetch("/api/orders");
          const data = await res.json();

          const ordersContainer = document.getElementById("ordersContainer");

          if (!data.ok || data.orders.length === 0) {
            ordersContainer.innerHTML = '<p style="text-align: center; color: #999;">Még nincsenek rendeléseid.</p>';
            return;
          }

          let html = '<div class="orders-list">';
          data.orders.forEach((order, index) => {
            html += `
              <div class="order-item">
                <div class="order-header">
                  <span class="order-id">#${index + 1} Rendelés</span>
                  <span class="order-date">${new Date(order.createdAt).toLocaleDateString("hu-HU")}</span>
                </div>
                <div class="order-details">
                  <p><strong>Termékek:</strong></p>
                  <ul>
                    ${JSON.parse(order.products || "[]")
                      .map((p) => `<li>${p.name} - ${p.price}</li>`)
                      .join("")}
                  </ul>
                  <p><strong>Szállítás:</strong> ${order.shippingType === "home" ? "🚚 Házhoz szállítás" : "🏪 Átvétel"}</p>
                  <p><strong>Összeg:</strong> <span class="order-total">${order.totalPrice.toLocaleString("hu-HU")} Ft</span></p>
                </div>
              </div>
            `;
          });
          html += "</div>";
          ordersContainer.innerHTML = html;
        } catch (err) {
          console.error(err);
          document.getElementById("ordersContainer").innerHTML =
            '<p style="color: #e74c3c;">Hiba történt a rendelések betöltésekor.</p>';
        }
      }

      // Foglalás törlése
      async function deleteBooking(bookingId) {
        document.getElementById("deleteConfirmModal").style.display = "flex";
        document.getElementById("deleteConfirmModal").dataset.bookingId = bookingId;
      }

      // Foglalások betöltése
      async function loadBookings() {
        try {
          const res = await fetch("/api/bookings");
          const data = await res.json();

          const bookingsContainer = document.getElementById("bookingsContainer");

          if (!data.ok || data.bookings.length === 0) {
            bookingsContainer.innerHTML = '<p style="text-align: center; color: #999;">Még nincsenek foglalásaid.</p>';
            return;
          }

          let html = '<div class="bookings-list">';
          data.bookings.forEach((booking) => {
            // Az UTC-ben tárolt időpont helyi időzónára való konvertálása
            const dt = new Date(booking.datetime);
            // Az offset-et eltávolítjuk, hogy az eredeti (helyi) időt kapjuk meg
            const offset = dt.getTimezoneOffset() * 60 * 1000;
            const localDate = new Date(dt.getTime() + offset);

            const bookingDate = localDate.toLocaleDateString("hu-HU");
            const bookingTime = localDate.toLocaleTimeString("hu-HU", { hour: "2-digit", minute: "2-digit" });
            html += `
              <div class="booking-item">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div>
                    <p><strong>Dátum:</strong> ${bookingDate} ${bookingTime}</p>
                    <p><strong>Szolgáltatás:</strong> ${booking.service || "Nem megadva"}</p>
                  </div>
                  <button onclick="deleteBooking(${booking.id})" class="delete-btn" title="Foglalás törlése">🗑️ Törlés</button>
                </div>
              </div>
            `;
          });
          html += "</div>";
          bookingsContainer.innerHTML = html;
        } catch (err) {
          console.error(err);
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        loadBookings();

        // Törlés megerősítés - Igen gomb
        document.getElementById("btnConfirmDelete").addEventListener("click", async () => {
          const modal = document.getElementById("deleteConfirmModal");
          const bookingId = parseInt(modal.dataset.bookingId);
          try {
            const res = await fetch(`/api/booking/${bookingId}`, {
              method: "DELETE",
            });
            const data = await res.json();

            if (res.ok && data.ok) {
              showToast("✓ Foglalás sikeresen törölve");
              document.getElementById("deleteConfirmModal").style.display = "none";
              loadBookings();
            } else {
              showToast("Hiba: " + (data.error || "Ismeretlen hiba"), "error");
              document.getElementById("deleteConfirmModal").style.display = "none";
            }
          } catch (err) {
            console.error(err);
            showToast("Nem sikerült elérni a szervert", "error");
            document.getElementById("deleteConfirmModal").style.display = "none";
          }
        });

        // Törlés megerősítés - Mégsem gomb
        document.getElementById("btnCancelDelete").addEventListener("click", () => {
          document.getElementById("deleteConfirmModal").style.display = "none";
        });
      });
    </script>
    <script src="/js/mobileNav.js"></script>
  </body>
</html>
