<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Klasszikus Borbély</title>
    <link rel="stylesheet" href="/css/index.css" />
  </head>
  <body>
    <!-- 🌊 VIDEÓ HÁTTÉR -->
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
      A böngésződ nem támogatja a videó elemet.
    </video>

    <header>
      <div class="logo">Beach Barbershop</div>

      <!-- Mobil jobb oldali gombok -->
      <div class="mobile-header-right">
        <!-- KOSÁR IKON (mobilon a header-ben) -->
        <div class="cart-menu mobile-cart">
          <img src="https://cdn-icons-png.flaticon.com/512/1170/1170576.png" class="cart-icon" alt="Kosár" title="Kosár" />
          <span class="cart-badge" id="cartBadgeMobile">0</span>
          <ul class="cart-dropdown" aria-hidden="true" id="cartDropdownMobile">
            <li class="cart-title">Kosár</li>
            <li id="cartItemsMobile" style="max-height: 300px; overflow-y: auto;"></li>
            <li class="cart-total"><strong>Összesen: <span id="cartSumMobile">0</span> Ft</strong></li>
            <li style="padding: 0;"><a href="/fizetes" style="display: block; background: #27ae60; padding: 0.6rem 1rem; color: white; font-weight: bold;">💳 Fizetés</a></li>
            <li><a href="/shop">Webshop</a></li>
          </ul>
        </div>

        <!-- Hamburger menü gomb mobilra -->
        <button class="hamburger" id="hamburgerBtn" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <nav id="mainNav">
        <ul class="nav-list">
          <!-- PROFIL (mobilon felül, ikonnal + almenü) -->
          <li class="profile-menu mobile-profile-top">
            <div class="mobile-profile-header">
              <img src="https://cdn-icons-png.flaticon.com/512/1077/1077063.png" class="mobile-profile-icon" alt="Profil" />
              <% if (user) { %>
              <span class="mobile-profile-toggle"><%= (user && user.role === 'ADMIN') ? 'Admin Panel' : 'Fiók' %> ▼</span>
              <% } else { %>
              <a href="/bejelentkezes">Bejelentkezés</a>
              <% } %>
            </div>
            <% if (user) { %>
            <ul class="mobile-profile-submenu">
              <li><a href="/fiok">Fiók részletek</a></li>
              <li><a href="/fiok#foglalasaim">Foglalásaim</a></li>
              <li><a href="/fiok#rendeleseim">Rendeléseim</a></li>
            </ul>
            <% } %>
          </li>

          <li><a href="#services">Szolgáltatások</a></li>
          <li><a href="/foglalas">Foglalás</a></li>
          <li><a href="/shop">Webshop</a></li>

          <!-- KIJELENTKEZÉS (csak mobilon, menü végén) -->
          <% if (user) { %>
          <li class="mobile-logout"><a href="/api/logout">Kijelentkezés</a></li>
          <% } %>

          <!-- KOSÁR IKON (desktopon) -->
          <li class="cart-menu desktop-cart">
            <img src="https://cdn-icons-png.flaticon.com/512/1170/1170576.png" class="cart-icon" alt="Kosár" title="Kosár" />
            <span class="cart-badge" id="cartBadge">0</span>

            <ul class="cart-dropdown" aria-hidden="true" id="cartDropdown">
              <li class="cart-title">Kosár</li>
              <li id="cartItems" style="max-height: 300px; overflow-y: auto;"></li>
              <li class="cart-total"><strong>Összesen: <span id="cartSum">0</span> Ft</strong></li>
              <li style="padding: 0;"><a href="/fizetes" style="display: block; background: #27ae60; padding: 0.6rem 1rem; color: white; font-weight: bold;">💳 Fizetés</a></li>
              <li><a href="/shop">Nyitd meg a shopp-ot</a></li>
            </ul>
          </li>

          <!-- PROFIL IKON MENÜ (desktopon) -->
          <li class="profile-menu desktop-profile">
            <img src="https://cdn-icons-png.flaticon.com/512/1077/1077063.png" class="profile-icon" alt="Profil" />

            <ul class="dropdown" aria-hidden="true">
              <% if (user) { %>
              <li style="padding: 0.6rem 1rem; color: #3cbcc7; font-weight: 700"><%= user.felhnev %></li>
              <li><a href="/fiok"><%= (user && user.role === 'ADMIN') ? 'Admin Panel' : 'Fiók' %></a></li>
              <li>
                <form action="/api/logout" method="get">
                  <button type="submit" class="logout-btn">Kijelentkezés</button>
                </form>
              </li>
              <% } else { %>
              <li><a href="/bejelentkezes">Bejelentkezés</a></li>
              <li><a href="/regisztracio">Regisztráció</a></li>
              <% } %>
            </ul>
          </li>
        </ul>
      </nav>
    </header>

    <section class="hero">
      <h1>Üdvözlünk a Beach Barbershop</h1>
      <p>Modern stílus, klasszikus borbély hangulat</p>
      <div class="plusz-info">
        <div class="service-nyitva">
          <strong>Nyitvatartás:</strong> H–P: 09:00 – 20:00, Szo: 09:00 – 15:00, V: Zárva
        </div>
        <div class="service-nyitva"><strong>Cím:</strong> Egervár Sárviz folyó</div>
        <div class="service-nyitva"><strong>Telefon:</strong> +36 30 123 4567</div>
      </div>
    </section>

    <section id="services">
      <h2>Szolgáltatásaink</h2>
      <div class="service-list">
        <div class="service">
          <h3>Hajvágás</h3>
          <p>Ár: 5000 Ft</p>
        </div>
        <div class="service">
          <h3>Szakállvágás</h3>
          <p>Ár: 3000 Ft</p>
        </div>
        <div class="service">
          <h3>Borotválás</h3>
          <p>Ár: 4000 Ft</p>
        </div>
        <div class="service">
          <h3>Férfi frizura & Szakáll csomag</h3>
          <p>Ár: 8000 Ft</p>
        </div>
      </div>
    </section>

    <!-- Foglalás rész áthelyezve külön oldalra: /foglalas -->

    <footer>
      <p>&copy; 2025 Beach Barbershop</p>
    </footer>

    <!-- Popup overlay -->
    <div id="popup" class="popup-overlay" aria-hidden="true">
      <div id="popupBox" class="popup-box" role="dialog" aria-modal="true">
        <div id="popupMsg">Üzenet</div>
        <div class="popup-actions">
          <button id="popupClose" class="popup-close">OK</button>
        </div>
      </div>
    </div>

    <script>
      // Kosár funkciók
      function updateCartDisplay() {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        
        // Desktop elemek
        const cartBadge = document.getElementById("cartBadge");
        const cartItems = document.getElementById("cartItems");
        const cartSum = document.getElementById("cartSum");
        
        // Mobil elemek
        const cartBadgeMobile = document.getElementById("cartBadgeMobile");
        const cartItemsMobile = document.getElementById("cartItemsMobile");
        const cartSumMobile = document.getElementById("cartSumMobile");

        const itemCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        
        // Badge frissítés mindkét helyen
        if (cartBadge) cartBadge.textContent = itemCount;
        if (cartBadgeMobile) cartBadgeMobile.textContent = itemCount;

        let total = 0;
        let itemsHtml = "";

        if (cart.length === 0) {
          itemsHtml = '<li style="padding: 1rem; text-align: center; color: #999;">Üres kosár</li>';
        } else {
          cart.forEach((item, index) => {
            const price = parseInt(item.price.replace(/\D/g, "")) || 0;
            const quantity = item.quantity || 1;
            const itemTotal = price * quantity;
            total += itemTotal;
            itemsHtml += `
              <li>
                <div style="padding: 0.5rem 1rem; border-bottom: 1px solid #555; color: #ccc; font-size: 0.9em;">
                  <div><strong>${item.name}</strong></div>
                  <div>${item.price} × ${quantity} = ${(itemTotal).toLocaleString("hu-HU")} Ft</div>
                  <button onclick="removeFromCart(${index})" style="background: #e74c3c; color: white; border: none; padding: 0.3rem 0.6rem; border-radius: 4px; cursor: pointer; font-size: 0.8em; margin-top: 0.3rem;">Eltávolít</button>
                </div>
              </li>
            `;
          });
        }

        // Tartalom frissítés mindkét helyen
        if (cartItems) cartItems.innerHTML = itemsHtml;
        if (cartItemsMobile) cartItemsMobile.innerHTML = itemsHtml;
        
        // Összeg frissítés mindkét helyen
        const totalStr = total.toLocaleString("hu-HU");
        if (cartSum) cartSum.textContent = totalStr;
        if (cartSumMobile) cartSumMobile.textContent = totalStr;
      }

      function removeFromCart(index) {
        let cart = JSON.parse(localStorage.getItem("cart")) || [];
        cart.splice(index, 1);
        localStorage.setItem("cart", JSON.stringify(cart));
        updateCartDisplay();
      }

      // MINDEN eseményregisztrációt csak a DOMContentLoaded után végzünk,
      // és mindig ellenőrizzük, hogy az elem létezik-e, hogy ne dobjon hibát.
      document.addEventListener("DOMContentLoaded", () => {
        // Kosár megjelenítés frissítése
        updateCartDisplay();

        // Kosár ikon klikk - mindkét kosárra (mobil és desktop)
        const cartIcons = document.querySelectorAll(".cart-icon");
        cartIcons.forEach(cartIcon => {
          const cartMenu = cartIcon.closest(".cart-menu");
          if (cartIcon && cartMenu) {
            cartIcon.addEventListener("click", (e) => {
              e.stopPropagation();
              cartMenu.classList.toggle("open");
              const cartDropdown = cartMenu.querySelector(".cart-dropdown");
              if (cartDropdown) {
                const isOpen = cartMenu.classList.contains("open");
                cartDropdown.setAttribute("aria-hidden", !isOpen);
              }
            });
          }
        });

        // Foglalás űrlap (ha van) — elküldjük a szervernek és feldolgozzuk a választ
        const fogForm = document.getElementById("foglalas_urlap");
        // Popup helper funkciók
        const popupOverlay = document.getElementById("popup");
        const popupBox = document.getElementById("popupBox");
        const popupMsg = document.getElementById("popupMsg");
        const popupClose = document.getElementById("popupClose");
        let popupTimer = null;

        function showPopup(message, type = "success", autoHide = true) {
          if (!popupOverlay || !popupBox || !popupMsg) return;
          popupMsg.textContent = message;
          popupBox.classList.remove("success", "error");
          popupBox.classList.add(type === "error" ? "error" : "success");
          popupOverlay.classList.add("show");
          popupOverlay.setAttribute("aria-hidden", "false");
          if (popupTimer) clearTimeout(popupTimer);
          if (autoHide) {
            const duration = type === "error" ? 5000 : 3000;
            popupTimer = setTimeout(hidePopup, duration);
          }
        }

        function hidePopup() {
          if (!popupOverlay) return;
          popupOverlay.classList.remove("show");
          popupOverlay.setAttribute("aria-hidden", "true");
          if (popupTimer) {
            clearTimeout(popupTimer);
            popupTimer = null;
          }
        }

        if (popupClose) popupClose.addEventListener("click", hidePopup);

        if (fogForm) {
          fogForm.addEventListener("submit", async function (e) {
            e.preventDefault();
            const formData = new URLSearchParams(new FormData(fogForm));

            try {
              const res = await fetch("/api/booking", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: formData,
              });

              const json = await res.json();
              if (res.ok && json.ok) {
                showPopup("Foglalás sikeresen rögzítve!", "success");
                fogForm.reset();
              } else if (json && json.error) {
                showPopup("Hiba: " + json.error, "error", true);
              } else {
                showPopup("Ismeretlen hiba történt. Próbáld újra.", "error", true);
              }
            } catch (err) {
              console.error(err);
              showPopup("Nem sikerült elérni a szervert.", "error", true);
            }
          });
        }

        // Bejelentkezés űrlap (ha van)
        const bejForm = document.getElementById("bejelentkezes_urlap");
        if (bejForm) {
          bejForm.addEventListener("submit", function (e) {
            e.preventDefault();
            alert("Bejelentkezés sikeres (demo)!");
          });
        }

        // Regisztráció űrlap (ha van)
        const regForm = document.getElementById("regisztracio_urlap");
        if (regForm) {
          regForm.addEventListener("submit", function (e) {
            e.preventDefault();
            alert("Regisztráció sikeres (demo)!");
          });
        }

        // Profil ikon -> lenyíló menü (desktop)
        const profileMenu = document.querySelector(".desktop-profile");
        const profileIcon = profileMenu ? profileMenu.querySelector(".profile-icon") : null;

        if (profileIcon && profileMenu) {
          // Nyitás / zárás
          profileIcon.addEventListener("click", (e) => {
            e.stopPropagation();
            profileMenu.classList.toggle("open");
            const dropdown = profileMenu.querySelector(".dropdown");
            if (dropdown) {
              const isOpen = profileMenu.classList.contains("open");
              dropdown.setAttribute("aria-hidden", !isOpen);
            }
          });
        }

        // Klikk bárhova -> bezár
        document.addEventListener("click", () => {
          if (profileMenu) {
            profileMenu.classList.remove("open");
            const dropdown = profileMenu.querySelector(".dropdown");
            if (dropdown) dropdown.setAttribute("aria-hidden", "true");
          }
          // Minden kosár menü bezárása
          document.querySelectorAll(".cart-menu").forEach(cm => cm.classList.remove("open"));
          document.querySelectorAll(".cart-dropdown").forEach(cd => cd.setAttribute("aria-hidden", "true"));
        });

        // Mobil profil almenü toggle
        const mobileProfileHeader = document.querySelector(".mobile-profile-header");
        const mobileProfileSubmenu = document.querySelector(".mobile-profile-submenu");
        const mobileProfileToggle = document.querySelector(".mobile-profile-toggle");
        
        if (mobileProfileHeader && mobileProfileSubmenu) {
          mobileProfileHeader.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileProfileSubmenu.classList.toggle("open");
            // Nyíl irány váltás
            if (mobileProfileToggle) {
              mobileProfileToggle.textContent = mobileProfileSubmenu.classList.contains("open") ? "Fiók ▲" : "Fiók ▼";
            }
          });
        }
      });
    </script>
    <script src="/js/mobileNav.js"></script>
  </body>
</html>
