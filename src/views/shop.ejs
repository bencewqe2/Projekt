<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Hajápolási Termékek</title>
    <link rel="stylesheet" href="/css/shop.css">
</head>
<body>
    <!-- 🌊 VIDEÓ HÁTTÉR -->
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
      A böngésződ nem támogatja a videó elemet.
    </video>

    <header>
      <a href="/" class="logo">Beach Barbershop</a>

      <!-- Mobil header jobb oldali rész (kosár + hamburger) -->
      <div class="mobile-header-right">
        <!-- Mobil kosár ikon -->
        <div class="cart-menu mobile-cart">
          <div class="cart-icon-wrap">
            <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            <span class="cart-badge" id="cartBadgeMobile">0</span>
          </div>
          <ul class="cart-dropdown" id="cartDropdownMobile">
            <li class="cart-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              <span>Kosár</span>
              <span class="cart-header-count" id="cartHeaderCountMobile">0 termék</span>
            </li>
            <li class="cart-items-wrap">
              <div id="cartItemsMobile"></div>
            </li>
            <li class="cart-total-row">
              <span>Összesen</span>
              <span class="cart-total-amount"><span id="cartSumMobile">0</span> Ft</span>
            </li>
            <li class="cart-actions">
              <a href="/fizetes" class="cart-btn-pay">💳 Fizetés</a>
              <button onclick="clearCart()" class="cart-btn-clear" title="Kosár törlése">🗑️</button>
            </li>
            <li class="cart-continue">
              <a href="/shop">Folytasd a vásárlást →</a>
            </li>
          </ul>
        </div>

        <!-- Hamburger menü gomb mobilra -->
        <button class="hamburger" id="hamburgerBtn" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <nav id="mainNav">
        <ul class="nav-list">
          <!-- Mobil profil a slide-in tetején + almenü -->
          <li class="profile-menu mobile-profile-top">
            <div class="mobile-profile-header">
              <img src="https://cdn-icons-png.flaticon.com/512/1077/1077063.png" class="mobile-profile-icon" alt="Profil" />
              <% if (user) { %>
              <span class="mobile-profile-toggle"><%= (user && user.role === 'ADMIN') ? 'Admin Panel' : 'Fiók' %> ▼</span>
              <% } else { %>
              <a href="/bejelentkezes">Bejelentkezés</a>
              <% } %>
            </div>
            <% if (user) { %>
            <ul class="mobile-profile-submenu">
              <li><a href="/fiok">Fiók részletek</a></li>
              <li><a href="/fiok#foglalasaim">Foglalásaim</a></li>
              <li><a href="/fiok#rendeleseim">Rendeléseim</a></li>
            </ul>
            <% } %>
          </li>

          <li><a href="/#services">Szolgáltatások</a></li>
          <li><a href="/foglalas">Foglalás</a></li>
          <li><a href="/shop">Webshop</a></li>

          <!-- KIJELENTKEZÉS (csak mobilon, menü végén) -->
          <% if (user) { %>
          <li class="mobile-logout"><a href="/api/logout">Kijelentkezés</a></li>
          <% } %>

          <!-- Desktop KOSÁR IKON -->
          <li class="cart-menu desktop-cart">
            <div class="cart-icon-wrap">
              <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              <span class="cart-badge" id="cartBadge">0</span>
            </div>

            <ul class="cart-dropdown" aria-hidden="true" id="cartDropdown">
              <li class="cart-header">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                <span>Kosár</span>
                <span class="cart-header-count" id="cartHeaderCount">0 termék</span>
              </li>
              <li class="cart-items-wrap">
                <div id="cartItems"></div>
              </li>
              <li class="cart-total-row">
                <span>Összesen</span>
                <span class="cart-total-amount"><span id="cartSum">0</span> Ft</span>
              </li>
              <li class="cart-actions">
                <a href="/fizetes" class="cart-btn-pay">💳 Fizetés</a>
                <button onclick="clearCart()" class="cart-btn-clear" title="Kosár törlése">🗑️</button>
              </li>
              <li class="cart-continue">
                <a href="/shop">Folytasd a vásárlást →</a>
              </li>
            </ul>
          </li>

          <!-- Desktop PROFIL IKON MENÜ -->
          <li class="profile-menu desktop-profile">
            <div class="profile-icon-wrap">
              <svg class="profile-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>

            <ul class="dropdown" aria-hidden="true">
              <% if (user) { %>
              <li style="padding: 0.6rem 1rem; color: #3cbcc7; font-weight: 700"><%= user.felhnev %></li>
              <li><a href="/fiok"><%= (user && user.role === 'ADMIN') ? 'Admin Panel' : 'Fiók' %></a></li>
              <li>
                <form action="/api/logout" method="get">
                  <button type="submit" class="logout-btn">Kijelentkezés</button>
                </form>
              </li>
              <% } else { %>
              <li><a href="/bejelentkezes">Bejelentkezés</a></li>
              <li><a href="/regisztracio">Regisztráció</a></li>
              <% } %>
            </ul>
          </li>
        </ul>
      </nav>
    </header>

    <div class="container">
        <h1>Hajápolási Termékek</h1>
        
        <!-- Szűrő Szekció -->
        <div class="filter-section">
            <h2>Kategória</h2>
            <div class="filter-buttons">
                <button class="filter-btn active" data-category="all">Összes Termék</button>
                <button class="filter-btn" data-category="haircare">💆 Hajápolás</button>
                <button class="filter-btn" data-category="styling">💇 Hajformázás</button>
                <button class="filter-btn" data-category="protection">🛡️ Védelem & Kiegészítők</button>
            </div>
        </div>
        
        <div class="products-grid" id="productsContainer">
            <!-- Sampon -->
            <div class="product-card" data-category="haircare">
                <div class="product-image">
                    <img src="/images/sampon.jpg" alt="Prémium Sampon">
                </div>
                <div class="product-info">
                    <h3>Prémium Sampon</h3>
                    <p class="description">Gyengéd tisztító formula minden hajtípushoz</p>
                    <p class="price">2,990 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Hajolaj -->
            <div class="product-card" data-category="haircare">
                <div class="product-image">
                    <img src="/images/hajolaj.jpg" alt="Argán Hajolaj">
                </div>
                <div class="product-info">
                    <h3>Argán Hajolaj</h3>
                    <p class="description">Intenzív ápolás és fény a száraz hajra</p>
                    <p class="price">4,490 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Hajpor -->
            <div class="product-card" data-category="protection">
                <div class="product-image">
                    <img src="/images/hajpor.jpg" alt="Szárazsampon Hajpor">
                </div>
                <div class="product-info">
                    <h3>Szárazsampon Hajpor</h3>
                    <p class="description">Frissen tartja a hajat, azonnali frisítés</p>
                    <p class="price">1,990 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Hajzselé -->
            <div class="product-card" data-category="styling">
                <div class="product-image">
                    <img src="/images/hajzele.jpg" alt="Formázó Hajzselé">
                </div>
                <div class="product-info">
                    <h3>Formázó Hajzselé</h3>
                    <p class="description">Erős tartás, csipesz- és hővédelem</p>
                    <p class="price">1,590 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Kondicionáló -->
            <div class="product-card" data-category="haircare">
                <div class="product-image">
                    <img src="/images/kondicionalo.jpg" alt="Mélyhidratáló Kondicionáló">
                </div>
                <div class="product-info">
                    <h3>Mélyhidratáló Kondicionáló</h3>
                    <p class="description">Regeneráló kezelés sérült hajra</p>
                    <p class="price">3,290 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Hajmaszk -->
            <div class="product-card" data-category="haircare">
                <div class="product-image">
                    <img src="/images/hajmaszk.jpg" alt="Intenzív Hajmaszk">
                </div>
                <div class="product-info">
                    <h3>Intenzív Hajmaszk</h3>
                    <p class="description">10 perces gyorskezelés fényes, sima hajért</p>
                    <p class="price">3,890 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Hajspray -->
            <div class="product-card" data-category="protection">
                <div class="product-image">
                    <img src="/images/hajspray.jpg" alt="UV Védő Hajspray">
                </div>
                <div class="product-info">
                    <h3>UV Védő Hajspray</h3>
                    <p class="description">Védelmi spray nap és hő ellen</p>
                    <p class="price">2,490 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>

            <!-- Hajfixi -->
            <div class="product-card" data-category="styling">
                <div class="product-image">
                    <img src="/images/hajfixi.jpg" alt="Erős Tartás Hajfixi">
                </div>
                <div class="product-info">
                    <h3>Erős Tartás Hajfixi</h3>
                    <p class="description">Professzionális rögzítés egész napra</p>
                    <p class="price">2,290 Ft</p>
                    <button class="btn-add-cart">Kosárba</button>
                </div>
            </div>
        </div>
    </div>

    <footer>
      <p>&copy; 2025 Beach Barbershop</p>
    </footer>

    <!-- Mennyiség kiválasztó modal -->
    <div id="quantityModal" class="quantity-modal" style="display: none;">
      <div class="quantity-modal-content">
        <h3 id="quantityProductName">Termék neve</h3>
        <div class="quantity-selector">
          <label>Mennyiség:</label>
          <input type="number" id="quantityInput" min="1" max="999" value="1" />
        </div>
        <div class="quantity-buttons">
          <button id="quantityConfirm" class="quantity-btn-confirm">✓ Kosárba</button>
          <button id="quantityCancel" class="quantity-btn-cancel">✕ Mégsem</button>
        </div>
      </div>
    </div>

    <script>
      // Kosár funkciók (ugyanaz mint az index.ejs-ben)
      function updateCartDisplay() {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        
        const cartBadge = document.getElementById("cartBadge");
        const cartItems = document.getElementById("cartItems");
        const cartSum = document.getElementById("cartSum");
        const cartHeaderCount = document.getElementById("cartHeaderCount");
        
        const cartBadgeMobile = document.getElementById("cartBadgeMobile");
        const cartItemsMobile = document.getElementById("cartItemsMobile");
        const cartSumMobile = document.getElementById("cartSumMobile");
        const cartHeaderCountMobile = document.getElementById("cartHeaderCountMobile");

        const itemCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        
        if (cartBadge) cartBadge.textContent = itemCount;
        if (cartBadgeMobile) cartBadgeMobile.textContent = itemCount;
        
        const countLabel = itemCount === 0 ? "Üres" : `${itemCount} termék`;
        if (cartHeaderCount) cartHeaderCount.textContent = countLabel;
        if (cartHeaderCountMobile) cartHeaderCountMobile.textContent = countLabel;

        let total = 0;
        let itemsHtml = "";

        if (cart.length === 0) {
          itemsHtml = '<div class="cart-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg><span>A kosár üres</span></div>';
        } else {
          cart.forEach((item, index) => {
            const price = parseInt(item.price.replace(/\D/g, "")) || 0;
            const quantity = item.quantity || 1;
            const itemTotal = price * quantity;
            total += itemTotal;
            itemsHtml += `
              <div class="cart-item">
                <div class="cart-item-info">
                  <span class="cart-item-name">${item.name}</span>
                  <span class="cart-item-meta">${quantity} × ${price.toLocaleString("hu-HU")} Ft</span>
                </div>
                <div class="cart-item-right">
                  <span class="cart-item-total">${itemTotal.toLocaleString("hu-HU")} Ft</span>
                  <button onclick="removeFromCart(${index})" class="cart-item-remove" title="Eltávolít">×</button>
                </div>
              </div>
            `;
          });
        }

        if (cartItems) cartItems.innerHTML = itemsHtml;
        if (cartItemsMobile) cartItemsMobile.innerHTML = itemsHtml;
        
        const totalStr = total.toLocaleString("hu-HU");
        if (cartSum) cartSum.textContent = totalStr;
        if (cartSumMobile) cartSumMobile.textContent = totalStr;
      }

      function removeFromCart(index) {
        let cart = JSON.parse(localStorage.getItem("cart")) || [];
        cart.splice(index, 1);
        localStorage.setItem("cart", JSON.stringify(cart));
        updateCartDisplay();
      }

      function clearCart() {
        localStorage.setItem("cart", JSON.stringify([]));
        updateCartDisplay();
      }

      let currentProductData = null;

      function showQuantityModal(productCard) {
        const productName = productCard.querySelector(".product-info h3").textContent;
        const productPrice = productCard.querySelector(".product-info .price").textContent;
        
        currentProductData = { name: productName, price: productPrice, card: productCard };
        
        document.getElementById("quantityProductName").textContent = productName;
        document.getElementById("quantityInput").value = 1;
        document.getElementById("quantityModal").style.display = "flex";
      }

      function hideQuantityModal() {
        document.getElementById("quantityModal").style.display = "none";
        currentProductData = null;
      }

      function addToCartWithQuantity() {
        if (!currentProductData) return;
        
        const quantity = parseInt(document.getElementById("quantityInput").value) || 1;
        if (quantity < 1) {
          alert("A mennyiség legalább 1 kell legyen!");
          return;
        }

        let cart = JSON.parse(localStorage.getItem("cart")) || [];
        const existingItem = cart.find(item => item.name === currentProductData.name);
        
        if (existingItem) {
          existingItem.quantity = (existingItem.quantity || 1) + quantity;
        } else {
          cart.push({
            name: currentProductData.name,
            price: currentProductData.price,
            quantity: quantity
          });
        }
        
        localStorage.setItem("cart", JSON.stringify(cart));
        updateCartDisplay();
        
        // Gombot megváltoztatjuk röviden
        const btn = currentProductData.card.querySelector(".btn-add-cart");
        const originalText = btn.textContent;
        btn.textContent = "✓ Hozzáadva!";
        btn.style.background = "#27ae60";
        setTimeout(() => {
          btn.textContent = originalText;
          btn.style.background = "";
        }, 2000);
        
        hideQuantityModal();
      }

      document.addEventListener("DOMContentLoaded", () => {
        // Szűrő funkciók
        const filterButtons = document.querySelectorAll(".filter-btn");
        const productCards = document.querySelectorAll(".product-card");

        filterButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            // Aktív gomb frissítése
            filterButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");

            // Szűrés
            const selectedCategory = btn.dataset.category;
            productCards.forEach((card) => {
              const cardCategory = card.dataset.category;
              if (selectedCategory === "all" || cardCategory === selectedCategory) {
                card.style.display = "block";
                setTimeout(() => card.classList.add("visible"), 10);
              } else {
                card.classList.remove("visible");
                setTimeout(() => card.style.display = "none", 300);
              }
            });
          });
        });

        // Kosár megjelenítés frissítése
        updateCartDisplay();

        // Kosár ikon klikk - mindkét kosárra (mobil és desktop)
        const cartIconWraps = document.querySelectorAll(".cart-icon-wrap");
        cartIconWraps.forEach(cartIconWrap => {
          const cartMenu = cartIconWrap.closest(".cart-menu");
          if (cartIconWrap && cartMenu) {
            cartIconWrap.addEventListener("click", (e) => {
              e.stopPropagation();
              cartMenu.classList.toggle("open");
              const cartDropdown = cartMenu.querySelector(".cart-dropdown");
              if (cartDropdown) {
                const isOpen = cartMenu.classList.contains("open");
                cartDropdown.setAttribute("aria-hidden", !isOpen);
              }
            });
          }
        });

        // Kosárba gomb klikk - mennyiség kiválasztást megnyit
        const cartButtons = document.querySelectorAll(".btn-add-cart");
        cartButtons.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            const productCard = btn.closest(".product-card");
            showQuantityModal(productCard);
          });
        });

        // Mennyiség modal gombok
        document.getElementById("quantityConfirm").addEventListener("click", addToCartWithQuantity);
        document.getElementById("quantityCancel").addEventListener("click", hideQuantityModal);
        
        // Mennyiség input Enter billentűkezelés
        document.getElementById("quantityInput").addEventListener("keypress", (e) => {
          if (e.key === "Enter") addToCartWithQuantity();
        });

        // Modal zárása a háttérre kattintva
        document.getElementById("quantityModal").addEventListener("click", (e) => {
          if (e.target.id === "quantityModal") hideQuantityModal();
        });

        // Profil ikon -> lenyíló menü (desktop)
        const profileMenu = document.querySelector(".desktop-profile");
        const profileIcon = profileMenu ? profileMenu.querySelector(".profile-icon-wrap") : null;

        if (profileIcon && profileMenu) {
          // Nyitás / zárás
          profileIcon.addEventListener("click", (e) => {
            e.stopPropagation();
            profileMenu.classList.toggle("open");
            const dropdown = profileMenu.querySelector(".dropdown");
            if (dropdown) {
              const isOpen = profileMenu.classList.contains("open");
              dropdown.setAttribute("aria-hidden", !isOpen);
            }
          });
        }

        // Klikk bárhova -> bezár
        document.addEventListener("click", () => {
          if (profileMenu) {
            profileMenu.classList.remove("open");
            const dropdown = profileMenu.querySelector(".dropdown");
            if (dropdown) dropdown.setAttribute("aria-hidden", "true");
          }
          // Minden kosár menü bezárása
          document.querySelectorAll(".cart-menu").forEach(cm => cm.classList.remove("open"));
          document.querySelectorAll(".cart-dropdown").forEach(cd => cd.setAttribute("aria-hidden", "true"));
        });

        // Mobil profil almenü toggle
        const mobileProfileHeader = document.querySelector(".mobile-profile-header");
        const mobileProfileSubmenu = document.querySelector(".mobile-profile-submenu");
        const mobileProfileToggle = document.querySelector(".mobile-profile-toggle");
        
        if (mobileProfileHeader && mobileProfileSubmenu) {
          mobileProfileHeader.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileProfileSubmenu.classList.toggle("open");
            // Nyíl irány váltás
            if (mobileProfileToggle) {
              mobileProfileToggle.textContent = mobileProfileSubmenu.classList.contains("open") ? "Fiók ▲" : "Fiók ▼";
            }
          });
        }
      });
    </script>
    <script src="/js/mobileNav.js"></script>
  </body>
  </html>
