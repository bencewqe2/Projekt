<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beach Barbershop</title>
    <link rel="stylesheet" href="/css/bejelentkezes.css" />
    
  </head>
  <body>
    <!-- Videó háttér -->
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
      A böngésződ nem támogatja a videó elemet.
    </video>

    <header>
      <a href="/" class="logo">Beach Barbershop</a>

      <!-- Hamburger menü gomb mobilra -->
      <button class="hamburger" id="hamburgerBtn" aria-label="Menü">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav id="mainNav">
        <ul>
          <li><a href="/">Vissza a főoldalra</a></li>
        </ul>
      </nav>
    </header>

    <section id="login">
      <h2>Bejelentkezés</h2>
      <form id="bejelentkezes_urlap" action="/api/login" method="post">
        <input type="text" name="username" placeholder="Felhasználónév" required />
        <input type="password" name="password" placeholder="Jelszó" required />
        <button type="submit">Bejelentkezés</button>

        <p class="regisztracio-link">Nincs még fiókod? <a href="/regisztracio">Regisztrálj!</a></p>
      </form>
    </section>

     <div id="errorModal" class="modal" aria-hidden="true">
      <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <p id="modalMessage">Hiba történt</p>
        <button id="modalClose">OK</button>
      </div>

    
    <script>
      (function () {
        const form = document.getElementById('bejelentkezes_urlap');
        const modal = document.getElementById('errorModal');
        const modalMessage = document.getElementById('modalMessage');
        const modalClose = document.getElementById('modalClose');

        function showModal(msg) {
          modalMessage.textContent = msg;
          modal.classList.add('show');
          modal.setAttribute('aria-hidden', 'false');
        }
        function hideModal() {
          modal.classList.remove('show');
          modal.setAttribute('aria-hidden', 'true');
        }

        modalClose.addEventListener('click', hideModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) hideModal();
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          const formData = new URLSearchParams(new FormData(form));

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: formData.toString(),
              credentials: 'same-origin'
            });

            // Ha sikeres -> átirányítás a főoldalra
            if (res.ok) {
              // Lehet, hogy a szerver redirect-el, de biztonságosan irányítsuk át a kliensről is
              window.location.href = '/';
              return;
            }

            // Hibák JSON-ként jönnek vissza (pl. { error: "..." } )
            let data;
            try {
              data = await res.json();
            } catch (err) {
              data = null;
            }

            const msg = (data && (data.error || data.message)) || 'Helytelen felhasználónév vagy jelszó';
            showModal(msg);
          } catch (err) {
            console.error(err);
            showModal('Nem sikerült csatlakozni a szerverhez. Próbáld újra később.');
          }
        });
      })();
    </script>
    <script src="/js/mobileNav.js"></script>
  </body>
</html>
