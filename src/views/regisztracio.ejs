<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beach Barbershop</title>
    <link rel="stylesheet" href="/css/regisztracio.css" />
  </head>
  <body>
    <!-- Videó háttér (seamless crossfade) -->
    <style>
      .bg-video-wrap {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
      }
      .bg-video {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.6s linear;
      }
      .bg-video.active {
        opacity: 1;
      }
    </style>

    <div class="bg-video-wrap">
      <video class="bg-video active" id="hatter_video_a" autoplay muted playsinline>
        <source src="/videos/video.mp4" type="video/mp4" />
      </video>
      <video class="bg-video" id="hatter_video_b" autoplay muted playsinline>
        <source src="/videos/video.mp4" type="video/mp4" />
      </video>
    </div>

    <script>
      (function () {
        const fadeDuration = 0.6;
        const preStart = 0.5;
        let a = document.getElementById("hatter_video_a");
        let b = document.getElementById("hatter_video_b");
        let current = a,
          next = b;
        function ensurePlay(v) {
          v.muted = true;
          const p = v.play();
          if (p && p.catch) p.catch(() => {});
        }
        ensurePlay(a);
        function tick() {
          if (!current.duration || isNaN(current.duration)) {
            requestAnimationFrame(tick);
            return;
          }
          if (current.duration - current.currentTime <= preStart) {
            next.currentTime = 0;
            ensurePlay(next);
            next.classList.add("active");
            current.classList.remove("active");
            const old = current;
            current = next;
            next = old;
            setTimeout(
              () => {
                next.pause();
              },
              (fadeDuration + 0.1) * 1000,
            );
          }
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      })();
    </script>

    <header>
      <div class="logo">Beach Barbershop</div>
      <nav>
        <ul>
          <li><a href="/">Vissza a főoldalra</a></li>
        </ul>
      </nav>
    </header>

    <section id="register">
      <h2>Regisztráció</h2>
      <form id="regisztracio_urlap" action="/api/register" method="post">
        <input type="text" name="username" placeholder="Teljes név" required />
        <input type="email" name="email" placeholder="Email cim" required />
        <input type="text" name="pnumber" placeholder="Telefonszám" required />
        <input type="password" name="password" placeholder="Jelszó" required />
        <input type="password" placeholder="Jelszó megerősítése" required />
        <button type="submit">Regisztráció</button>

        <p class="regisztracio-link">Már van fiókod? <a href="/bejelentkezes">Jelentkezz be!</a></p>
      </form>
    </section>

    <footer>
      <p>&copy; 2025 Beach Barbershop</p>
    </footer>

    <script>
      document.getElementById("bejelentkezes_urlap").addEventListener("submit", function (e) {
        e.preventDefault();
        alert("Bejelentkezés sikeres (demo)!");
      });
    </script>
    <script src="/js/mobileNav.js"></script>
  </body>
</html>
