<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beach Barbershop</title>
    <link rel="stylesheet" href="/css/regisztracio.css" />
  </head>
  <body>
    <!-- 🌊 VIDEÓ HÁTTÉR -->
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
      A böngésződ nem támogatja a videó elemet.
    </video>

    <header>
      <a href="/" class="logo">Beach Barbershop</a>

      <!-- Hamburger menü gomb mobilra -->
      <button class="hamburger" id="hamburgerBtn" aria-label="Menü">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav id="mainNav">
        <ul>
          <li><a href="/">Vissza a főoldalra</a></li>
        </ul>
      </nav>
    </header>

    <section id="register">
      <h2>Regisztráció</h2>
      <form id="regisztracio_urlap" action="/api/register" method="post">
        <input type="text" name="username" placeholder="Teljes név" required />
        <input type="email" name="email" placeholder="Email cim" required />
        <div class="phone-group">
          <select name="pnumber_prefix" class="phone-prefix">
            <option value="+36">🇭🇺 +36</option>
            <option value="+1">🇺🇸 +1</option>
            <option value="+44">🇬🇧 +44</option>
            <option value="+49">🇩🇪 +49</option>
            <option value="+33">🇫🇷 +33</option>
            <option value="+40">🇷🇴 +40</option>
            <option value="+43">🇦🇹 +43</option>
            <option value="+421">🇸🇰 +421</option>
            <option value="+420">🇨🇿 +420</option>
            <option value="+48">🇵🇱 +48</option>
          </select>
          <input type="tel" name="pnumber" placeholder="Telefonszám" required />
        </div>
        <input type="password" name="password" placeholder="Jelszó" required />
        <input type="password" placeholder="Jelszó megerősítése" required />
        <button type="submit">Regisztráció</button>

        <p class="regisztracio-link">Már van fiókod? <a href="/bejelentkezes">Jelentkezz be!</a></p>
      </form>
    </section>

    <footer>
      <p>&copy; 2025 Beach Barbershop</p>
    </footer>

    <script src="/js/mobileNav.js"></script>
  </body>
</html>
