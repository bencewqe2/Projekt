<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel – Beach Barbershop</title>
    <link rel="stylesheet" href="/css/fiok.css" />
  </head>
  <body>
    <video id="hatter_video" autoplay muted loop>
      <source src="/videos/video.mp4" type="video/mp4" />
    </video>

    <header>
      <div class="logo">Beach Barbershop - Admin</div>

      <!-- Hamburger menü gomb mobilra -->
      <button class="hamburger" id="hamburgerBtn" aria-label="Menü">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav id="mainNav">
        <ul class="nav-list">
          <!-- ADMIN PROFIL (mobilon felül) -->
          <li class="profile-menu mobile-profile-top">
            <div class="mobile-profile-header">
              <img src="https://cdn-icons-png.flaticon.com/512/1077/1077063.png" class="mobile-profile-icon" alt="Admin" />
              <span class="mobile-profile-toggle">Fiók ▼</span>
            </div>
            <ul class="mobile-profile-submenu">
              <li><a href="#">Fiók részletek</a></li>
              <li><a href="/fiok">Vissza a Fiók-ra</a></li>
            </ul>
          </li>
        </ul>
      </nav>
    </header>

    <div class="account-header">Admin: <%= user.felhnev %></div>

    <div class="account-wrapper" style="flex-direction: column; max-width: 900px;">
      <!-- Tab Navigator - Admin panelhez nem kell, mivel csak egy tab van -->
      <div class="account-tab-navigator">
        <button id="tab-prev-btn" class="tab-arrow-btn">◀</button>
        <span id="tab-title-display" class="tab-title-display">Fiók részletek</span>
        <button id="tab-next-btn" class="tab-arrow-btn">▶</button>
      </div>

      <main class="account-content">
        <section id="bookings" class="account-section active">
          <h2>Foglalások kezelése</h2>
          <div id="bookingsContainer"></div>
        </section>

        <section id="users" class="account-section">
          <h2>Felhasználók kezelése</h2>
          <div id="usersContainer"></div>
        </section>

        <section id="orders" class="account-section">
          <h2>Rendelések kezelése</h2>
          <button onclick="deleteAllOrders()" class="btn-danger" style="margin-bottom: 1rem;">🗑️ Az összes rendelés törlése</button>
          <div id="ordersContainer"></div>
        </section>
      </main>
    </div>

    <!-- User Edit Modal -->
    <div id="userModal" class="user-modal">
      <div class="user-modal-content">
        <h3 id="userModalTitle">Felhasználó szerkesztése</h3>
        <div class="user-form">
          <label>Felhasználónév<br /><input id="up_felhnev" type="text" /></label>
          <label>Email<br /><input id="up_email" type="email" /></label>
          <label>Telefonszám<br /><input id="up_telefonszam" type="text" /></label>
          <label
            >Szerep<br /><select id="up_role">
              <option>USER</option>
              <option>BARBER</option>
              <option>ADMIN</option>
            </select></label
          >
          <label
            >Jelszó (ha új jelszót szeretnél beállítani)<br /><input
              id="up_password"
              type="password"
              placeholder="Hagyd üresen ha nem változik"
            /></label>
          <div class="user-modal-buttons">
            <button id="btnSaveUser" class="btn-confirm">💾 Mentés</button>
            <button id="btnDeleteUser" class="btn-danger">🗑️ Törlés</button>
            <button id="btnClosePanel" class="btn-cancel">✕ Bezár</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div id="toastNotification" class="toast-notification"></div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteConfirmModal" class="delete-confirm-modal">
      <div class="delete-confirm-content">
        <h3>Törlés megerősítése</h3>
        <p id="deleteConfirmMessage">Biztosan törlöd a felhasználót?</p>
        <div class="delete-confirm-buttons">
          <button id="btnConfirmDelete" class="btn-confirm">✓ Igen, törlöm</button>
          <button id="btnCancelDelete" class="btn-cancel">✕ Mégsem</button>
        </div>
      </div>
    </div>

    <script>
      // Az aktuális bejelentkezett admin ID-je
      const currentAdminId = <%= user.id %>;
      
      // Tab System - Admin panelhez csak az "info" tab kell
      const tabs = [
        { id: "bookings", label: "Foglalások" },
        { id: "users", label: "Felhasználók" },
        { id: "orders", label: "Rendelések" }
      ];
      let currentTabIndex = 0;

      function showSection(id) {
        // Find tab index
        const tabIndex = tabs.findIndex((t) => t.id === id);
        if (tabIndex !== -1) {
          currentTabIndex = tabIndex;
        }

        // Update all sections - remove active class
        document.querySelectorAll(".account-section").forEach((s) => s.classList.remove("active"));

        // Add active class to selected section
        const section = document.getElementById(id);
        if (section) {
          section.classList.add("active");
        }

        // Update tab title
        const currentTab = tabs[currentTabIndex];
        if (currentTab) {
          document.getElementById("tab-title-display").textContent = currentTab.label;
        }
      }

      function navigateTab(direction) {
        currentTabIndex = (currentTabIndex + direction + tabs.length) % tabs.length;
        showSection(tabs[currentTabIndex].id);
      }



      async function loadBookings() {
        const container = document.getElementById("bookingsContainer");
        container.innerHTML = '<p style="text-align:center;color:#999">Betöltés...</p>';
        try {
          const res = await fetch("/api/admin/bookings");
          const json = await res.json();
          console.log("loadBookings:", json);
          if (!res.ok) throw new Error(json.error || "Hiba");
          if (!json.bookings || json.bookings.length === 0) {
            container.innerHTML = '<p style="text-align:center;color:#999">Nincs foglalás.</p>';
            return;
          }
          let html = '<div class="bookings-list">';
          json.bookings.forEach((b) => {
            html += `<div class="booking-item">
              <div>
                <p style="margin: 0.3rem 0;"><strong>Dátum:</strong> ${new Date(b.datetime).toLocaleString("hu-HU")}</p>
                <p style="margin: 0.3rem 0;"><strong>Szolgáltatás:</strong> ${b.service || "—"}</p>
                <p style="margin: 0.3rem 0;"><strong>Felhasználó:</strong> ${b.user ? b.user.felhnev : "ismeretlen"}</p>
                <p style="margin: 0.3rem 0; color: #999; font-size: 0.85rem;">${b.user ? b.user.email : ""}</p>
              </div>
              <div style="margin-top:0.5rem;">
                <button onclick="deleteBooking(${b.id})" class="delete-btn">🗑️ Törlés</button>
              </div>
            </div>`;
          });
          html += "</div>";
          container.innerHTML = html;
        } catch (err) {
          console.error(err);
          container.innerHTML = '<p style="color:#e74c3c;">Hiba történt a foglalások betöltésekor.</p>';
        }
      }

      async function loadOrders() {
        const container = document.getElementById("ordersContainer");
        container.innerHTML = '<p style="text-align:center;color:#999">Betöltés...</p>';
        try {
          const res = await fetch("/api/admin/orders");
          const json = await res.json();
          console.log("loadOrders:", json);
          if (!res.ok) throw new Error(json.error || "Hiba");
          if (!json.orders || json.orders.length === 0) {
            container.innerHTML = '<p style="text-align:center;color:#999">Nincs rendelés.</p>';
            return;
          }
          let html = '<div class="orders-list">';
          json.orders.forEach((o) => {
            const products = (() => {
              try {
                return JSON.parse(o.products || "[]")
                  .map((p) => `<li>${p.name} - ${p.price} × ${p.quantity || 1}</li>`)
                  .join("");
              } catch (e) {
                return "<li>Nem értelmezhető</li>";
              }
            })();
            html += `<div class="order-item">
              <div class="order-header">
                <span>#${o.id}</span>
                <span>${new Date(o.createdAt).toLocaleString("hu-HU")}</span>
              </div>
              <div class="order-details">
                <p><strong>Felhasználó:</strong> ${o.user ? o.user.felhnev : "ismeretlen"}</p>
                <p style="color: #999; font-size: 0.85rem; margin: 0.2rem 0;">${o.user ? o.user.email : ""}</p>
                <p style="margin-top: 0.5rem;"><strong>Szállítás:</strong> ${o.shippingType}</p>
                <p><strong>Összeg:</strong> ${o.totalPrice} Ft</p>
                <p style="margin: 0.5rem 0;"><strong>Termékek:</strong></p>
                <ul>${products}</ul>
              </div>
              <div style="margin-top: 0.5rem;">
                <button onclick="deleteOrder(${o.id})" class="delete-btn">🗑️ Törlés</button>
              </div>
            </div>`;
          });
          html += "</div>";
          container.innerHTML = html;
        } catch (err) {
          console.error(err);
          container.innerHTML = '<p style="color:#e74c3c;">Hiba történt a rendelések betöltésekor.</p>';
        }
      }

      async function loadUsers() {
        const container = document.getElementById("usersContainer");
        container.innerHTML = '<p style="text-align:center;color:#999">Betöltés...</p>';
        try {
          const res = await fetch("/api/admin/users");
          const json = await res.json();
          console.log("loadUsers:", json);
          if (!res.ok) throw new Error(json.error || "Hiba");
          if (!json.users || json.users.length === 0) {
            container.innerHTML = '<p style="text-align:center;color:#999">Nincsenek felhasználók.</p>';
            return;
          }
          let html = '<div class="users-list">';
          window.usersData = json.users;
          json.users.forEach((u) => {
            html += `<div class="user-item">
              <div class="user-header">
                <div>
                  <p style="margin:0;color:#3cbcc7;font-weight:bold;font-size:1rem;">${u.felhnev}</p>
                  <p style="margin:0.3rem 0 0 0;color:#999;font-size:0.8rem;">ID: ${u.id}</p>
                </div>
                <div style="text-align:left;">
                  <p style="margin:0;color:#ddd;font-size:0.9rem;"><strong>Email:</strong></p>
                  <p style="margin:0.2rem 0;color:#aaa;font-size:0.85rem; word-break: break-word;">${u.email}</p>
                  <p style="margin:0.5rem 0 0 0;font-size:0.8rem;">Szerep: <span style="color:#3cbcc7;">${u.role}</span></p>
                </div>
              </div>
              <div class="user-details">
                <p style="margin:0.4rem 0;"><strong>Telefon:</strong> ${u.telefonszam}</p>
              </div>
              <div class="user-actions">
                <button onclick="selectUser(${u.id})" class="action-btn">✎ Szerkeszt</button>
              </div>
            </div>`;
          });
          html += "</div>";
          container.innerHTML = html;
        } catch (err) {
          console.error(err);
          container.innerHTML = '<p style="color:#e74c3c;">Hiba történt a felhasználók betöltésekor.</p>';
        }
      }

      function selectUser(id) {
        const u = (window.usersData || []).find((x) => x.id === id);
        if (!u) {
          showToast("Felhasználó nem található", "error");
          return;
        }
        document.getElementById("up_felhnev").value = u.felhnev || "";
        document.getElementById("up_email").value = u.email || "";
        document.getElementById("up_telefonszam").value = u.telefonszam || "";
        document.getElementById("up_role").value = u.role || "USER";
        document.getElementById("up_password").value = "";
        
        // Ha az admin saját magát szerkeszti, a role selectet letiltjuk
        const roleSelect = document.getElementById("up_role");
        const isOwnProfile = id === currentAdminId;
        roleSelect.disabled = isOwnProfile;
        if (isOwnProfile) {
          roleSelect.title = "Nem módosíthatod a saját jogosultságodat";
        } else {
          roleSelect.title = "";
        }
        
        document.getElementById("userModal").style.display = "flex";
        document.getElementById("userModal").dataset.userId = id;
      }

      function editUser(id) {
        selectUser(id);
      }

      function changePassword(id) {
        selectUser(id);
      }

      function showToast(message, type = "success") {
        const toast = document.getElementById("toastNotification");
        toast.textContent = message;
        toast.className = `toast-notification toast-${type} show`;
        setTimeout(() => {
          toast.classList.remove("show");
        }, 3000);
      }

      let pendingConfirmAction = null;

      function openConfirm(message, action) {
        const modal = document.getElementById("deleteConfirmModal");
        const msgEl = document.getElementById("deleteConfirmMessage");
        if (msgEl) {
          msgEl.textContent = message;
        }
        pendingConfirmAction = action;
        modal.style.display = "flex";
      }

      function deleteUser(id) {
        openConfirm("Biztosan törlöd a felhasználót?", async () => {
          try {
            const res = await fetch(`/api/admin/user/${id}`, { method: "DELETE" });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || "Hiba");
            showToast("✓ Felhasználó törölve");
            loadUsers();
          } catch (err) {
            console.error(err);
            showToast("Hiba történt a törléskor", "error");
          }
        });
      }

      async function deleteBooking(id) {
        openConfirm("Biztosan törlöd ezt a foglalást?", async () => {
          try {
            const res = await fetch(`/api/admin/booking/${id}`, { method: "DELETE" });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || "Hiba");
            showToast("✓ Foglalás törölve");
            loadBookings();
          } catch (err) {
            console.error(err);
            showToast("Hiba történt a foglalás törlésekor", "error");
          }
        });
      }

      async function deleteAllBookings() {
        openConfirm("Biztosan TÖRLÖD az ÖSSZES foglalást?", async () => {
          try {
            const res = await fetch("/api/admin/bookings", { method: "DELETE" });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || "Hiba");
            const count = typeof j.deleted === "number" ? j.deleted : "";
            showToast(`✓ Összes foglalás törölve${count !== "" ? ` (${count} db)` : ""}`);
            loadBookings();
          } catch (err) {
            console.error(err);
            showToast("Hiba történt az összes foglalás törlésekor", "error");
          }
        });
      }

      async function deleteOrder(id) {
        openConfirm("Biztosan törlöd a rendelést?", async () => {
          try {
            const res = await fetch(`/api/admin/order/${id}`, { method: "DELETE" });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || "Hiba");
            showToast("✓ Rendelés törölve");
            loadOrders();
          } catch (err) {
            console.error(err);
            showToast("Hiba történt a rendelés törlésekor", "error");
          }
        });
      }


      async function deleteAllOrders() {
        openConfirm("Biztosan TÖRLÖD az ÖSSZES rendelést?", async () => {
          try {
            const res = await fetch("/api/admin/orders", { method: "DELETE" });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || "Hiba");
            const count = typeof j.deleted === "number" ? j.deleted : "";
            showToast(`✓ Összes rendelés törölve${count !== "" ? ` (${count} db)` : ""}`);
            loadOrders();
          } catch (err) {
            console.error(err);
            showToast("Hiba történt az összes rendelés törlésekor", "error");
          }
        });
      }
      

      document.addEventListener("DOMContentLoaded", () => {
        // Initialize tab navigator
        document.getElementById("tab-prev-btn").addEventListener("click", () => navigateTab(-1));
        document.getElementById("tab-next-btn").addEventListener("click", () => navigateTab(1));

        // Initialize first tab
        showSection("bookings");
        
        // Load data
        loadBookings();
        loadUsers();
        loadOrders();

        // Bezárás gomb
        document.getElementById("btnClosePanel").addEventListener("click", () => {
          document.getElementById("userModal").style.display = "none";
        });

        // Mentés gomb
        document.getElementById("btnSaveUser").addEventListener("click", async () => {
          const modal = document.getElementById("userModal");
          const id = parseInt(modal.dataset.userId);
          const form = new URLSearchParams();
          form.append("felhnev", document.getElementById("up_felhnev").value);
          form.append("email", document.getElementById("up_email").value);
          form.append("telefonszam", document.getElementById("up_telefonszam").value || "0");
          form.append("role", document.getElementById("up_role").value || "USER");

          const password = document.getElementById("up_password").value;
          if (password) {
            form.append("password", password);
          }

          try {
            const res = await fetch(`/api/admin/user/${id}/update`, {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: form,
            });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || "Hiba");
            showToast("✓ Felhasználó sikeresen mentve");
            document.getElementById("userModal").style.display = "none";
            loadUsers();
          } catch (err) {
            console.error(err);
            showToast("Hiba történt a mentéskor", "error");
          }
        });

        // Törlés gomb a felhasználó szerkesztő modalban
        document.getElementById("btnDeleteUser").addEventListener("click", async () => {
          const modal = document.getElementById("userModal");
          const id = parseInt(modal.dataset.userId);
          openConfirm("Biztosan törlöd a felhasználót?", async () => {
            try {
              const res = await fetch(`/api/admin/user/${id}`, { method: "DELETE" });
              const j = await res.json();
              if (!res.ok) throw new Error(j.error || "Hiba a szerveren");
              showToast("✓ Felhasználó sikeresen törölve");
              document.getElementById("userModal").style.display = "none";
              loadUsers();
            } catch (err) {
              console.error("Törlési hiba:", err);
              showToast("Hiba történt a törléskor: " + err.message, "error");
            }
          });
        });

        // Törlés megerősítés - Igen gomb (általános)
        document.getElementById("btnConfirmDelete").addEventListener("click", async () => {
          try {
            if (typeof pendingConfirmAction === "function") {
              await pendingConfirmAction();
            }
          } finally {
            pendingConfirmAction = null;
            document.getElementById("deleteConfirmModal").style.display = "none";
          }
        });

        // Törlés megerősítés - Mégsem gomb
        document.getElementById("btnCancelDelete").addEventListener("click", () => {
          pendingConfirmAction = null;
          document.getElementById("deleteConfirmModal").style.display = "none";
        });
      });
    </script>

    <script src="/js/mobileNav.js"></script>
  </body>
</html>
